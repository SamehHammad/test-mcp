# Postgres connection string (Neon, Supabase, local...). Prisma schema is Postgres.
DATABASE_URL=
# Password for the /login admin UI
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie (>= 32 chars)
SESSION_SECRET=
# One variable per token: MCP_TOKEN_<NAME>=<scope>:<token>  (scope: read | create | write | admin)
# The token name (used in the audit log) is the lowercased <NAME>.
MCP_TOKEN_OWNER=
MCP_TOKEN_CREATOR=
MCP_TOKEN_VIEWER=
# Optional (Neon): direct, non-pooled URL used only by `prisma migrate` (drop "-pooler" from the host)
DIRECT_URL=
